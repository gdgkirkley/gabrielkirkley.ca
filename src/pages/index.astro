---
import Fox from "../../images/gk-fox.svg";
import Button from "../components/Button.astro";
import Columns from "../components/Columns.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
  <main>
    <div class="content">
      <div class="title">
        <h1>Gabe Kirkley</h1>
        <p class="tagline">Senior Software Engineer</p>
        <Fox />
        <p>
          Building features for{" "}
          <a
            href="https://www.quo.com/"
            target="_blank"
            rel="noreferrer noopener"
          >
            Quo
          </a>{" "}
          and running{" "}
          <a
            href="https://patronsend.com/"
            target="_blank"
            rel="noreferrer noopener"
          >
            PatronSend
          </a>
          . Directing and designing film and theatre. Learning more about
          running companies.
        </p>
      </div>
      <Columns mdColumns="2fr 1fr" class="actions">
        <Button href="/portfolio">See my portfolio &rarr;</Button>
        <div class="contact">
          <a href="/contact">Get in touch</a>
        </div>
      </Columns>
    </div>
  </main>
</BaseLayout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    height: 100%;

    & :global(svg) {
      width: 30%;
      height: auto;
    }
  }

  .title {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    & h1 {
      font-weight: 800;
      text-align: center;
      margin-bottom: 0px;
      font-size: var(--fontSize-banner);
    }

    @media (min-width: 768px) {
      & p {
        max-width: 54%;
      }
    }
  }

  .tagline {
    color: var(--primary5);
  }

  .content :global(.actions) {
    justify-content: center;
    align-items: center;
    margin: 1rem auto;
  }

  .contact {
    display: flex;
    justify-content: center;
  }
</style>
