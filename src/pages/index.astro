---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPortfolio, getPosts } from "../lib/content";

const posts = await getPosts();
const portfolio = await getPortfolio();
---

<BaseLayout>
  <main>
    <h1>Astro migration in progress</h1>
    <h2>Posts</h2>
    <ul>
      {posts.map(post => <li>{post.data.date.toISOString().slice(0, 10)} <code>{post.data.slug}</code> {post.data.title}</li>)}
    </ul>
    <h2>Portfolio</h2>
    <ul>
      {portfolio.map(entry => <li>[{entry.data.type}] <code>{entry.data.slug}</code> {entry.data.title}</li>)}
    </ul>
  </main>
</BaseLayout>
