---
import Card from "../../components/Card.astro";
import Columns from "../../components/Columns.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPortfolio } from "../../lib/content";

const entries = await getPortfolio();
const projects = entries.filter(entry => entry.data.type === "project");
const challenges = entries.filter(entry => entry.data.type === "challenge");
---

<BaseLayout title="Portfolio">
  <main>
    <h1>Portfolio</h1>
    <section class="block">
      <h2 class="block-title">Projects</h2>
      <Columns mdColumns="1fr 1fr" gap="4rem">
        {projects.map(({ data }) => (
          <Card
            image={data.image}
            title={data.title}
            description={data.subtitle}
            url={data.slug}
            source={data.source}
          />
        ))}
      </Columns>
    </section>
    <section class="block">
      <h2 class="block-title">Challenges</h2>
      <Columns mdColumns="1fr 1fr" gap="4rem">
        {challenges.map(({ data }) => (
          <Card
            image={data.image}
            title={data.title}
            description={data.using}
            url={data.slug}
            source={data.source}
          />
        ))}
      </Columns>
    </section>
  </main>
</BaseLayout>

<style>
  .block {
    padding: 20px 0px;
  }

  .block-title {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0 0 3rem;
    font-family: var(--font-mono-stack);
    font-size: var(--fontSize-information);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mutedColor);

    &::after {
      content: "";
      flex: 1;
      border-top: 1px solid var(--ruleColor);
    }
  }
</style>
