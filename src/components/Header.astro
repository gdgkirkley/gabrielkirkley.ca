---
import config from "../../config/website";
import Fox from "../../images/gk-fox.svg";
import Social from "./Social.astro";

const navLinks = [
  { href: "/portfolio", label: "Portfolio", partiallyActive: true },
  { href: "/blog", label: "Blog", partiallyActive: true },
  { href: "/about", label: "About", partiallyActive: false },
  { href: "/contact", label: "Contact", partiallyActive: false },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string, partiallyActive: boolean) =>
  pathname === href || (partiallyActive && pathname.startsWith(`${href}/`));
---

<header>
  <nav>
    <a class="site-title" href="/">
      {pathname !== "/" && <Fox />}
      {config.siteTitle}
    </a>
    <button
      class="menu-button"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="menu" id="site-menu">
      <div class="nav-group">
        {
          navLinks.map(({ href, label, partiallyActive }) => (
            <a
              class:list={["nav-link", { current: isCurrent(href, partiallyActive) }]}
              href={href}
              aria-current={isCurrent(href, partiallyActive) ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </div>
      <div class="nav-group">
        <Social />
      </div>
      <div class="nav-group">
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg
            class="sun"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            class="moon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    min-height: 80px;
    justify-content: space-between;
  }

  nav {
    display: flex;
    justify-content: space-between;
    width: 100%;
    height: 80px;
    margin: 0px 32px 0px 0px;
    position: relative;
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 120px;
    margin: 0px 0px 0px 32px;
    padding: 8px 12px;
    font-weight: bolder;
    font-size: 22px;
    z-index: 2;
    color: var(--titleColor);
    border-radius: 1000px;
    transition: all 0.4s ease-in-out;

    & :global(svg) {
      width: 12%;
      height: auto;
    }
  }

  .menu-button {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 7px;
    width: 48px;
    height: 48px;
    margin: auto 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--navLinkColor);

    & span {
      display: block;
      width: 28px;
      height: 3px;
      border-radius: 2px;
      background: currentColor;
      transition: transform 0.3s ease, opacity 0.2s ease;
    }

    &[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(10px) rotate(45deg);
    }
    &[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }
    &[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-10px) rotate(-45deg);
    }
  }

  .menu {
    display: none;

    &.open {
      display: grid;
      justify-content: center;
      align-items: center;
      grid-template-rows: 2fr 1fr;
      position: fixed;
      top: 80px;
      bottom: 0;
      left: 0;
      z-index: 999;
      overflow-y: scroll;
      overflow-x: hidden;
      background: var(--background);
      width: 100%;
    }
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 0px 24px;
    margin-bottom: 24px;

    & :global(svg) {
      width: 2.8rem;
      height: auto;
    }
  }

  .nav-link {
    font-size: var(--fontSize-emphasis);
    font-weight: bold;
    line-height: 1;
    margin: 0;
    margin-top: 30px;
    padding: 0.25rem;
    border-bottom: 2px solid var(--navLinkUnderlineInactiveColor);
    transition: 0.1s ease-in-out;
    position: relative;
    height: 100%;

    &:first-of-type {
      margin-top: 80px;
    }

    &.current {
      border-bottom-color: var(--navLinkUnderlineActiveColor);
    }
  }

  .theme-toggle {
    border: none;
    background: none;
    color: var(--linkColor);

    &:hover {
      color: var(--textColor);
    }

    &:focus {
      outline: none;
    }

    & .moon {
      display: none;
    }
  }

  :global(html.dark-theme) .theme-toggle {
    & .sun {
      display: none;
    }
    & .moon {
      display: inline;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  /* Below this width the nav collapses into the hamburger menu (keep in sync with the script). */
  @media (min-width: 1245px) {
    nav {
      margin: 0px 0px 0px 32px;
      flex-direction: row;
    }

    .menu-button {
      display: none;
    }

    .menu {
      display: flex;
      align-items: center;
      overflow-y: auto;
    }

    .nav-group {
      margin-bottom: 0px;
      flex-direction: row;
    }

    .nav-link {
      height: auto;
      margin: 0 2rem 0 0;

      &:first-of-type {
        margin-top: 0px;
      }
    }
  }
</style>

<script>
  const root = document.documentElement;
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-button")!;
  const menu = document.querySelector<HTMLElement>("#site-menu")!;
  const desktop = window.matchMedia("(min-width: 1245px)");

  const setMenuOpen = (open: boolean) => {
    menu.classList.toggle("open", open);
    menuButton.setAttribute("aria-expanded", String(open));
    root.classList.toggle("menu-open", open);
  };

  menuButton.addEventListener("click", () => {
    setMenuOpen(!menu.classList.contains("open"));
  });

  desktop.addEventListener("change", event => {
    if (event.matches) setMenuOpen(false);
  });

  document.querySelector(".theme-toggle")!.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark-theme");
    try {
      localStorage.setItem("gabrielkirkley.ca_darkmode", JSON.stringify(isDark));
    } catch {}
  });
</script>
