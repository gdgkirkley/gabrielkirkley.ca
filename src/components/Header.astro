---
import config from "../../config/website";
import Fox from "../../images/gk-fox.svg";
import Social from "./Social.astro";

const navLinks = [
  { href: "/portfolio", label: "Portfolio", partiallyActive: true },
  { href: "/blog", label: "Blog", partiallyActive: true },
  { href: "/about", label: "About", partiallyActive: false },
  { href: "/contact", label: "Contact", partiallyActive: false },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string, partiallyActive: boolean) =>
  pathname === href || (partiallyActive && pathname.startsWith(`${href}/`));
---

<header>
  <nav>
    <a class="site-title" href="/">
      {pathname !== "/" && <Fox />}
      {config.siteTitle}
    </a>
    <button
      class="menu-button"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="menu" id="site-menu">
      <div class="nav-group">
        {navLinks.map(({ href, label, partiallyActive }) => (
          <a
            class:list={[
              "nav-link",
              { current: isCurrent(href, partiallyActive) },
            ]}
            href={href}
            aria-current={isCurrent(href, partiallyActive) ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </div>
      <div class="nav-group">
        <Social />
      </div>
      <div class="nav-group">
        <button
          class="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
        >
          <svg
            class="sun"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            class="moon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    min-height: 64px;
    border-bottom: 1px solid var(--ruleColor);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 64px;
    padding: 0 16px 0 24px;
    position: relative;
  }

  a {
    text-decoration: none;

    &:hover {
      background: none;
    }
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display-stack);
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--titleColor);
    z-index: 2;

    & :global(svg) {
      width: 30px;
      height: auto;
      margin: 0;
    }
  }

  .menu-button {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: var(--titleColor);

    & span {
      display: block;
      width: 24px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 0.3s ease,
        opacity 0.2s ease;
    }

    &[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    &[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }
    &[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }

  .menu {
    display: none;

    &.open {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 40px;
      position: fixed;
      top: 64px;
      bottom: 0;
      left: 0;
      z-index: 999;
      overflow-y: auto;
      background: var(--background);
      width: 100%;
    }
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;

    & :global(svg) {
      width: 2rem;
      height: auto;
    }
  }

  .nav-link {
    font-family: var(--font-mono-stack);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--titleColor);
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease;

    &:hover {
      border-bottom-color: var(--lavender);
    }

    &.current {
      border-bottom-color: var(--amber);
    }
  }

  .theme-toggle {
    display: inline-flex;
    padding: 6px;
    border: none;
    background: none;
    color: var(--titleColor);

    &:hover {
      color: var(--mutedColor);
    }

    & svg {
      width: 2rem;
      margin: 0;
    }

    & .moon {
      display: none;
    }
  }

  :global(html.dark-theme) .theme-toggle {
    & .sun {
      display: none;
    }
    & .moon {
      display: inline;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  /* Below this width the nav collapses into the menu button (keep in sync with the script). */
  @media (min-width: 768px) {
    nav {
      padding: 0 24px;
    }

    .menu-button {
      display: none;
    }

    .menu {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-group {
      flex-direction: row;
      gap: 24px;
    }

    .nav-group + .nav-group {
      gap: 4px;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-button")!;
  const menu = document.querySelector<HTMLElement>("#site-menu")!;
  const desktop = window.matchMedia("(min-width: 768px)");

  const setMenuOpen = (open: boolean) => {
    menu.classList.toggle("open", open);
    menuButton.setAttribute("aria-expanded", String(open));
    root.classList.toggle("menu-open", open);
  };

  menuButton.addEventListener("click", () => {
    setMenuOpen(!menu.classList.contains("open"));
  });

  desktop.addEventListener("change", event => {
    if (event.matches) setMenuOpen(false);
  });

  document.querySelector(".theme-toggle")!.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark-theme");
    try {
      localStorage.setItem(
        "gabrielkirkley.ca_darkmode",
        JSON.stringify(isDark),
      );
    } catch {}
  });
</script>
