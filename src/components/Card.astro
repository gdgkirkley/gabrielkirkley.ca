---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Source from "../../images/code-branch-light.svg";
import Button from "./Button.astro";
import Columns from "./Columns.astro";
import SourceUnavailable from "./SourceUnavailable.astro";

interface Props {
  image: ImageMetadata;
  title: string;
  description?: string;
  url: string;
  source?: string;
}

const { image, title, description, url, source } = Astro.props;
---

<article class="card">
  <Image
    src={image}
    alt=""
    width={900}
    height={400}
    fit="cover"
    layout="constrained"
  />
  <div class="card-content">
    <div>
      <h3>{title}</h3>
      {description && <p>{description}</p>}
    </div>
    <Columns columns="1fr 1fr">
      {source ? (
        <Button
          class="above-link"
          href={source}
          target="_blank"
          rel="noreferrer noopener"
        >
          Code <Source />
        </Button>
      ) : (
        <SourceUnavailable />
      )}
      <Button class="card-link" href={url} aria-label={`View ${title}`}>
        View &rarr;
      </Button>
    </Columns>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    justify-content: space-around;
    align-items: center;
    justify-self: center;
    width: 400px;
    max-width: 100%;
    height: 100%;
    padding-bottom: 1rem;
    overflow: hidden;
    z-index: 0;
    text-align: center;
    background-color: var(--surface);
    border: 1px solid var(--ruleColor);
    border-radius: var(--borderRadius);
    box-shadow: var(--shadow);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    flex-direction: column;

    &:hover {
      transform: translateY(-3px);
    }

    @media (prefers-reduced-motion: reduce) {
      &:hover {
        transform: none;
      }
    }
  }

  .card-content {
    display: grid;
    gap: 2rem;
    padding: 2rem;

    & h3 {
      font-size: var(--fontSize-highLevel);
      margin: 0 0 0.8rem;
    }

    & p {
      margin: 0;
      color: var(--mutedColor);
    }
  }

  /* The "View" link covers the whole card so it stays clickable like the old card,
     without nesting the "Code" link inside another link. */
  .card :global(.card-link) {
    position: static;
  }

  .card :global(.card-link)::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card :global(.above-link) {
    z-index: 2;
  }
</style>
