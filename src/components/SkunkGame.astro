<div id="game"></div>

<style>
  #game {
    display: grid;
    justify-content: center;
    align-items: center;
    margin: 20px;
    padding: 10px;
    border: 1px solid var(--ruleColor);
    background: var(--surface);
    border-radius: 4px;
    overflow-x: scroll;
    min-height: 750px;
  }
</style>

<!-- The game builds its own DOM, so its elements need unscoped styles. -->
<style is:global>
  #game {
    & .game-root {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      width: 100%;
    }

    & p {
      margin: 5px 0px;
      max-width: 100%;

      &:last-of-type {
        margin-bottom: 20px;
      }
    }

    & button {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      font-size: 21px;
      line-height: 1;
      cursor: pointer;
      user-select: none;
      padding: 16px 32px;
      text-decoration: none;
      color: var(--textColor);
      border: none;
      background-color: transparent;
      font-family: inherit;
      position: relative;
      isolation: isolate;

      & svg {
        width: 14px;
        margin: 0;
        margin-left: 16px;
      }

      &::after {
        content: "";
        padding: 16px 32px;
        transition: 0.5s all;
        background-color: var(--background);
        border: 1px solid var(--lavender);
        position: absolute;
        inset: 0;
        border-radius: 4px;
        z-index: -1;
      }

      &:hover::after {
        transform: scale(1.1);
      }

      &:disabled {
        color: #999;
        border-color: #999;

        &:hover {
          background-color: #fff;
          color: #999;
          cursor: initial;
        }
      }
    }

    & input,
    & textarea {
      width: calc(100% - 16px);
      margin: 8px 0px;
      padding: 16px 24px;
      min-height: 36px;
      border: 1px solid var(--lavender);
      color: var(--textColor);
      border-radius: 4px;
      background: var(--surface);
      transition: 0.3s linear;
      font-family: var(--font-body-stack);
      font-weight: 400;
      font-size: 17px;

      &:hover,
      &:focus {
        border: 1px solid var(--mutedColor);
      }
    }

    & table {
      margin: 20px 0px;
      padding: 5px;
      text-align: center;
      width: 100%;

      & thead {
        background-color: var(--buttonHoverColor);
        color: var(--buttonHoverTextColor);
      }

      & tbody {
        margin: 0px;
        padding: 0px;
      }

      & th,
      & td {
        border-left: 1px solid var(--ruleColor);
        border-bottom-width: 0;
        border-right-width: 0;
        border-top-width: 0;
        font-size: inherit;
        margin: 0;
        overflow: visible;
      }
    }
  }
</style>

<script>
  import { setUpGame } from "../scripts/skunk";

  setUpGame();
</script>
