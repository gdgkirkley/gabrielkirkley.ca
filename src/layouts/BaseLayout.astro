---
import "../styles/global.css";
import config from "../../config/website";
import Header from "../components/Header.astro";
import Seo, { type Props as SeoProps } from "../components/Seo.astro";

type Props = SeoProps;
---

<html lang={config.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...Astro.props} />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a light-mode flash.
      try {
        if (JSON.parse(localStorage.getItem("gabrielkirkley.ca_darkmode"))) {
          document.documentElement.classList.add("dark-theme");
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="page">
      <Header />
      <div class="wrapper">
        <slot />
      </div>
      <footer>© {new Date().getFullYear()}, {config.author}</footer>
    </div>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
  }

  .wrapper {
    height: 100%;
    display: flex;
    align-items: stretch;
    flex: 1 1 auto;
    overflow: hidden;
    z-index: 1;
  }
</style>
